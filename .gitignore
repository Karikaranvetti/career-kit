# Sensitive notes that never leave this machine (salary, health, family, anything you choose)
private/

# Secrets: never commit
.env
*.key
*secret*

# Build output (the CV source is tracked; PDFs are rebuilt)
cv/*.pdf
!cv/sent/*.pdf

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Generated by tools/pack.sh; rebuilt from the files, holds the same personal data
context-pack.md
